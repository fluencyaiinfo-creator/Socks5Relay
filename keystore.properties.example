# Copy this file to keystore.properties (same directory) and fill in your real values.
# keystore.properties itself is gitignored — never commit it or share it, it's your app's
# signing identity. Losing it later means you can no longer publish updates to the same
# Play Store listing under the same app, so keep a backup somewhere safe and private.

storeFile=../release-key.jks
storePassword=CHANGE_ME
keyAlias=socksrelay
keyPassword=CHANGE_ME
